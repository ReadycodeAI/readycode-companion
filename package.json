{
  "name": "readycode-companion",
  "productName": "ReadyCode Companion",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "portable": "npm run build && node scripts/portable.mjs"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
